{
  "default": "cf",
  "providers": {
    "cf": {
      "kind": "cloudflare",
      "model": "@cf/cloudflare/clef-flash",
      "accountId": "",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN"
    },
    "ts": {
      "kind": "typesafe",
      "model": "jev-latest",
      "apiKeyEnv": "TYPESAFE_API_KEY"
    },
    "or": {
      "kind": "openrouter",
      "model": "baseten/mammoth-1:free",
      "apiKeyEnv": "OPENROUTER_KEY"
    },
    "local": {
      "kind": "systemone",
      "baseUrl": "http://localhost:8000/v1/systemone",
      "model": "clef-flash",
      "apiKeyEnv": "LOCAL_API_KEY",
      "unwrap": "auto"
    },
    "liquid": {
      "kind": "systemone",
      "baseUrl": "http://127.0.0.1:9931/v1/systemone",
      "model": "d1-2B",
      "unwrap": "auto",
      "imageFormat": "dataUrl",
      "timeoutMs": 300000,
      "launch": {
        "command": "llama-server",
        "args": ["-hf", "LiquidAI/d1-2B-GGUF:Q8_0", "-b", "8192", "-ub", "8192"],
        "port": 9931,
        "startTimeoutMs": 240000,
        "autoStart": "always",
        "console": true
      }
    },
    "mock": {
      "kind": "mock",
      "fixturesDir": "./fixtures/mock"
    }
  }
}
