#!/usr/bin/env sh
# Pre-commit: guardas de seguridad + lint-staged (eslint/secretlint/vitest related) + typecheck condicional.
set -e

node scripts/precommit-guards.mjs
if [ -f node_modules/.bin/lint-staged ]; then
  # Husky corre con sh: el shim de .bin evita el arranque extra de `pnpm exec`.
  node_modules/.bin/lint-staged
else
  pnpm exec lint-staged
fi
node scripts/precommit-typecheck.mjs
