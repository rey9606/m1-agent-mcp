{
  "name": "m1-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentes de decisión (Clef/JEV) definidos por recetas JSON. CLI + motor de flujo.",
  "bin": {
    "m1": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "m1": "tsx src/cli/index.ts",
    "build": "tsup src/cli/index.ts src/index.ts --format esm --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:integration": "vitest run tests/integration",
    "test:live": "node scripts/run-live-tests.mjs",
    "lint": "eslint .",
    "precommit": "node scripts/precommit-guards.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "vitest related --run --passWithNoTests"
    ],
    "*.{ts,mts,cts,js,mjs,cjs,json,md,yml,yaml,sh,txt,example}": "secretlint",
    "examples/*.json": "node scripts/validate-recipes.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^22.10.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "secretlint": "^13.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
